 *
 * nRF52840-DK + WeAct Studio 2.9" E-Paper Display (128x296)
 * Pin mapping for WeAct Studio display
 */

&pinctrl {
	spi1_default: spi1_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 15)>,   /* SCL - P1.15 */
				<NRF_PSEL(SPIM_MOSI, 1, 13)>,  /* SDA - P1.13 */
				<NRF_PSEL(SPIM_MISO, 1, 14)>;  /* MISO - P1.14 (not used) */
		};
	};

	spi1_sleep: spi1_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 1, 15)>,
				<NRF_PSEL(SPIM_MOSI, 1, 13)>,
				<NRF_PSEL(SPIM_MISO, 1, 14)>;
			low-power-enable;
		};
	};
};

&spi1 {
	compatible = "nordic,nrf-spim";
	status = "okay";
	pinctrl-0 = <&spi1_default>;
	pinctrl-1 = <&spi1_sleep>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio1 12 GPIO_ACTIVE_LOW>;  /* CS - P1.12 */

	epaper: epaper@0 {
		compatible = "weact,epaper";
		reg = <0>;
		spi-max-frequency = <2000000>;
		reset-gpios = <&gpio1 11 GPIO_ACTIVE_LOW>;   /* RES - P1.11 */
		dc-gpios = <&gpio1 10 GPIO_ACTIVE_HIGH>;     /* DC - P1.10 */
		busy-gpios = <&gpio1 8 GPIO_ACTIVE_HIGH>;    /* BUSY - P1.08 */
		width = <128>;
		height = <296>;
		panel-type = <0>; /* EPD213_219 - also supports 2.9" */
		color-mode = "bw";
	};
};
